# Text is stored and checked out with LF on every platform, as in the working tree this
# repository was exported from (Rust ignores the difference; include_str! tests see the same bytes).
* text=auto eol=lf

# cmd.exe parses batch files reliably only with CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary fixtures and assets: never converted, never diffed as text.
*.bin   binary
*.mccap binary
*.nbt   binary
*.dat   binary
*.ttf   binary
*.png   binary
*.jpg   binary
